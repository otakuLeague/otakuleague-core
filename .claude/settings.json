{
  "permissions": {
    "deny": [
      "Bash(git clean *x*)",
      "Bash(git clean *X*)",
      "Bash(git stash *-a*)",
      "Bash(git stash *-u*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-ai-attribution.sh\" || exit 2"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.sh\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.sh\" || exit 2"
          }
        ]
      }
    ]
  }
}
