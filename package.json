{
  "name": "otakuleague-core",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node -e \"const fs = require('fs'); if (fs.existsSync('.githooks') && fs.existsSync('.git')) { try { require('child_process').execSync('git config core.hooksPath .githooks'); } catch (error) { console.warn('Could not set git hooksPath:', error.message); } }\"",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm --filter @otakuleague/shared-types build && pnpm -r lint",
    "typecheck": "pnpm --filter @otakuleague/shared-types build && pnpm -r typecheck",
    "test": "pnpm --filter @otakuleague/shared-types build && pnpm -r test",
    "test:integration": "pnpm --filter @otakuleague/shared-types build && pnpm -r --if-present test:integration",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:logs": "docker compose logs -f db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
