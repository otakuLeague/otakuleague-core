# Copy to .env (cp .env.example .env). Dev-only placeholders, never real secrets.

# Postgres superuser created by the container on first start.
POSTGRES_USER=otakuleague
# Password for POSTGRES_USER, local container only.
POSTGRES_PASSWORD=otakuleague_dev_password
# Dev database, created by the container on first start.
POSTGRES_DB=otakuleague
# Test database, created by docker/postgres/init so tests never touch dev data.
POSTGRES_TEST_DB=otakuleague_test
# Host port bound on 127.0.0.1; change it if 5432 is already in use.
POSTGRES_PORT=5432

# Connection string for the dev database, used by the API and the Prisma CLI; keep in sync with the values above.
DATABASE_URL=postgresql://otakuleague:otakuleague_dev_password@127.0.0.1:5432/otakuleague
# Connection string for the test database; API tests copy it into DATABASE_URL. Keep in sync with the values above.
DATABASE_URL_TEST=postgresql://otakuleague:otakuleague_dev_password@127.0.0.1:5432/otakuleague_test

# API runtime mode: development | test | production. Swagger UI (/docs) is off in production.
NODE_ENV=development
# API HTTP port (integer 1-65535, default 3001). apps/api loads this file; real env vars win.
PORT=3001

# Base URL of the API for server-side calls from apps/web (server-only: never prefix it with NEXT_PUBLIC_).
# Absolute http(s) URL, no credentials, query or fragment; a trailing slash is removed. Use 127.0.0.1, not localhost.
API_BASE_URL=http://127.0.0.1:3001
