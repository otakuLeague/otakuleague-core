# Copy to .env (cp .env.example .env). Dev-only placeholders, never real secrets.

# Postgres superuser created by the container on first start.
POSTGRES_USER=otakuleague
# Password for POSTGRES_USER, local container only.
POSTGRES_PASSWORD=otakuleague_dev_password
# Dev database, created by the container on first start.
POSTGRES_DB=otakuleague
# Test database, created by docker/postgres/init so tests never touch dev data.
POSTGRES_TEST_DB=otakuleague_test
# Host port bound on 127.0.0.1; change it if 5432 is already in use.
POSTGRES_PORT=5432

# Connection string for the dev database, used by the API and the Prisma CLI; keep in sync with the values above.
DATABASE_URL=postgresql://otakuleague:otakuleague_dev_password@127.0.0.1:5432/otakuleague
# Test database for `pnpm test:integration`, dropped and recreated on each run; name must end in _test. Keep in sync with the values above.
DATABASE_URL_TEST=postgresql://otakuleague:otakuleague_dev_password@127.0.0.1:5432/otakuleague_test

# API runtime mode: development | test | production. Swagger UI (/docs) is off in production.
NODE_ENV=development
# API HTTP port (integer 1-65535, default 3001). apps/api loads this file; real env vars win.
PORT=3001

# Base URL of the API for server-side calls from apps/web (server-only: never prefix it with NEXT_PUBLIC_).
# Absolute http(s) URL, no credentials, query or fragment; a trailing slash is removed. Use 127.0.0.1, not localhost.
API_BASE_URL=http://127.0.0.1:3001

# Sentry error tracking (ADR 0004). All optional: leave a DSN empty and that app sends nothing.
# DSN of the API's Sentry project (Project Settings > Client Keys). Validated at API boot.
SENTRY_DSN=
# DSN of the web app's Sentry project, used by the web server and the browser.
# Public by design (it only allows sending events), hence NEXT_PUBLIC_. Restart `pnpm dev` after changing it.
NEXT_PUBLIC_SENTRY_DSN=
# Environment tag for both apps; defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Release tag for both apps; defaults to the git commit SHA. Set by CI on deploy.
SENTRY_RELEASE=

# Anime data sources (ADR 0006, OTA-92). Kill switches, default true: false stops calling that
# source and hides everything it stored, without deleting it. Read at API start.
ANIME_SOURCE_ANILIST_ENABLED=true
ANIME_SOURCE_JIKAN_ENABLED=true
# Optional base URLs; empty means https://graphql.anilist.co and https://api.jikan.moe/v4.
ANILIST_API_URL=
JIKAN_API_URL=

# Internal API key (ADR 0019): a secret shared by the API and the web server. Empty = the API answers
# any caller (fine locally). Set, every API route except GET /health needs it in X-Internal-Api-Key.
# Generate with `openssl rand -hex 32` (43-128 chars of A-Z a-z 0-9 _ -). Never commit a real value.
INTERNAL_API_KEY=
# Old key, still accepted during a rotation (docs/deploy.md); needs INTERNAL_API_KEY. Empty otherwise.
INTERNAL_API_KEY_PREVIOUS=
# API only: Vercel previews' own key, a different value from both keys above (the API refuses to
# boot if equal; it compares only its own variables, so it cannot see a production key pasted into
# Vercel's Preview environment). Accepted as a "preview" caller on GET and HEAD only: X-Client-Ip
# ignored, one import bucket for all previews. Does nothing while INTERNAL_API_KEY is empty.
# Vercel's Preview environment holds this value under the name INTERNAL_API_KEY. Leave empty locally.
INTERNAL_API_KEY_PREVIEW=
# API only: true refuses to start without INTERNAL_API_KEY (the preview key does not count), in
# any NODE_ENV. Empty or false: no boot check; without INTERNAL_API_KEY the API starts open and
# warns in production. Production sets true.
INTERNAL_API_KEY_REQUIRED=
