# Paths the "Autopilot merge" workflow never merges: a PR touching any of them waits for Farouk.
# One bash pattern per line, matched against the whole repo-relative path (`*` also matches `/`).
# The workflow reads this file from main, so a PR cannot loosen the rules it is checked against.
# docs/AUTOPILOT.md describes the same list in words.

# CI, git hooks, and what steers Claude (only .claude/rules/* stays mergeable: build PRs update it).
.github/*
.githooks/*
.claude/settings*
.claude/hooks/*
.claude/skills/*
.claude/agents/*
.claude/commands/*
*.mcp.json
CLAUDE.md
docs/AUTOPILOT.md

# Code that runs at install, clean or build time, and the configs that make CI strict.
scripts/*
*.pnpmfile.cjs
*eslint.config*
*vitest.config*
*tsconfig*.json
*.prettierrc*
*.prettierignore

# Dependencies (CLAUDE.md: a new dependency needs a reason Farouk accepts).
*package.json
*pnpm-lock.yaml
*pnpm-workspace.yaml
*.npmrc
*.nvmrc

# Database schema changes (production data from the launch on).
*/migrations/*

# Deploy and infrastructure config.
*vercel.json
*railway.json
*railway.toml
*Dockerfile*
*.dockerignore
*docker/*
*docker-compose*

# Secrets templates.
*.env*
